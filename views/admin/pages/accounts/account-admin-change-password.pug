
extends ../../layouts/default.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="accountAdminChangePasswordForm")
        input(type="hidden" name="id" value=account.id)
        .row
          .col-md-12.col-lg-12
            .mb-3 Họ tên: <b>#{account.fullName}</b>
          .col-md-12.col-lg-12
            .mb-3 Email: <b>#{account.email}</b>
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="password") Mật khẩu mới
              input.form-control(id="password" type="password" name="password")
        button.btn.btn-primary(type="submit") Cập nhật
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/accounts/account-list`) Hủy