extends ../../layouts/default.pug
include ../../mixins/checkbox.pug
include ../../mixins/form-group.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="accountAdminEditForm")
        input(type="hidden" name="id" value=account.id)
        .row
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="name") Họ tên *
              input.form-control(id="name" type="text" name="name" value=account.name)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="email") Email *
              input.form-control(id="email" type="email" name="email" value=account.email)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="status") Trạng thái
              select.form-select(id="status" name="status")
                option(
                  value="initial"
                  selected=(account.status == "initial")
                  ) Khởi tạo
                option(
                  value="active"
                  selected=(account.status == "active")
                  ) Hoạt động
                option(
                  value="inactive"
                  selected=(account.status == "inactive")
                  ) Tạm dừng
          .col-md-6.col-lg-6
          .col-md-6.col-lg-6
            .mb-3
              +form-group-file(
                "Ảnh đại diện",
                "avatar",
                "avatar",
                account.avatar
              )
          .col-md-6.col-lg-6
            .mb-3
              label.form-label Nhóm quyền
              div(class="checkbox-list" checkbox-list="roles")
                +checkbox(roleList, 0, account.roles)
        button.btn.btn-primary(type="submit") Cập nhật
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/accounts/account-list`) Hủy
