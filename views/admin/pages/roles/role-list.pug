extends ../../layouts/default.pug
include ../../mixins/pagination.pug
include ../../mixins/form-search.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-primary(
                href=`/${pathAdmin}/roles/role-create`
                )
                i.fa-solid.fa-plus.me-1
                | Tạo nhóm quyền
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
            .col-lg-2
              a.btn.w-100.btn-info(href=`/${pathAdmin}/roles/role/export/csv`)
                i.fa-solid.fa-download.me-1
                | Xuất Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th STT
                  th Tên nhóm quyền
                  th Mô tả
                  th Trạng thái
                  th.text-end Hành động
              tbody
                each item, index in roles
                  tr
                    td #{pagination.skip + index + 1}
                    td #{item.name}
                    td #{item.description}
                    td
                      if (item.status == "active")
                        span(class="badge bg-success") Hoạt động
                      else if (item.status == "inactive")
                        span(class="badge bg-danger") Tạm dừng
                    td.text-end
                      a(href=`/${pathAdmin}/roles/role-edit/${item.id}`)
                        i.las.la-pen.text-secondary.fs-18
                      a(
                        href="javascript:;"
                        button-api
                        data-method="PATCH"
                        data-api=`/${pathAdmin}/roles/role-delete/${item.id}`
                      )
                        i.las.la-trash-alt.text-secondary.fs-18
          +pagination()
    // end col
