extends ../../layouts/default.pug
include ../../mixins/pagination.pug
include ../../mixins/form-search.pug

block main 
  if (permissions.includes('product-list'))
    .container
      .row
        .col-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title #{title}
            .card-body.pt-0
              .row
                .col-lg-6
                  +form-search()
                .col-lg-2
                  a.btn.w-100.btn-info(href=`/${pathAdmin}/products/product/export/csv`)
                    i.fa-solid.fa-download.me-1
                    | Xuất Excel
              .table-responsive
                table.table.mb-0.checkbox-all(id="datatable_1")
                  thead.table-light
                    tr
                      th(style="width: 16px;")
                        .form-check.mb-0
                          input#select-all.form-check-input(
                            name="select-all" 
                            type="checkbox"
                            )
                      th.ps-0 STT
                      th Avatar
                      th Tên sản phẩm
                      th Vị trí
                      th Số biến thể
                      th Danh mục
                      th Còn lại
                      th Trạng thái
                      th Lượt xem
                      th.text-end Hành động
                  tbody
                    each product, index in products
                      tr
                        td
                          .form-check.mb-0
                            input.form-check-input(
                              name="select-item" 
                              type="checkbox"
                              )
                        td #{pagination.skip + index + 1}
                        td
                          if product && product.images && product.images.length > 0
                            img(
                              src=`${domainCDN}${product.images[0]}` 
                              alt="Avatar"
                              width="50"
                              height="50"
                            )
                          else
                            img.avatar-sm.rounded-circle(src=`/${pathAdmin}/assets/images/default-avatar.png" alt="Avatar`)
                        td #{product && product.name ? product.name : 'Không có'}
                        td #{product && typeof product.position !== 'undefined' ? product.position : 0}
                        td #{product && product.variants ? product.variants.length : 0}
                        td
                          if !product.categoryListName || product.categoryListName.length <= 0
                            span.badge.bg-light.text-dark Không có
                          else
                            each category in product.categoryListName
                              span.badge.bg-info.text-white.me-1 #{category}
                        td #{product && product.stock !== 'undefined' ? product.stock : 0}
                        td
                          if product && product.status === 'draft'
                            span.badge.bg-success.text-white Nháp
                          else if product && product.status === 'published'
                            span.badge.bg-primary.text-white Công khai
                          else if product && product.status === 'archived'
                            span.badge.bg-danger.text-white Lưu trữ
                          else
                            span.badge.bg-light.text-dark Không xác định
                        td #{product && typeof product.views !== 'undefined' ? product.views : 0}
                        td.text-end
                          if product && product._id
                            a.btn.btn-sm.btn-primary.me-1(href=`/${pathAdmin}/products/product-edit/${product._id}`)
                              i.fa-solid.fa-pen-to-square
                            a.btn.btn-sm.btn-danger(
                              href=`javascript:;`
                              button-api
                              data-method="PATCH"
                              data-api=`/${pathAdmin}/products/product-delete/${product._id}`
                              )
                              i.fa-solid.fa-trash
              +pagination()