extend ../../layouts/default.pug
include ../../mixins/options.pug
include ../../mixins/form-group.pug
include ../../mixins/checkbox.pug

block main 
  if (permissions.includes('product-create'))
    .container
      .row
        .col-12
          h1 Tạo sản phẩm
      .card-body.pt-0
        form(id="createProductForm")
          .row
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên sản phẩm *
                input.form-control(
                  id="name"
                  name="name"
                  type="text"
                  )
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="slug") Đường dẫn *
                .input-group
                  span.btn.btn-outline-info(
                    btn-generate-slug="Product"
                    from="name"
                    to="slug"
                  ) Tự động
                  input.form-control(id="slug" name="slug" type="text")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-control(
                  id="status"
                  name="status"
                  )
                    option(value="draft") Nháp
                    option(value="published") Công khai
                    option(value="archived") Lưu trữ
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="category") Danh mục
                div(class="checkbox-list" checkbox-list="category")
                  +checkbox(categories)
            .col-md-12.col-lg-12
              .mb-3
                +form-group-file(
                  "Ảnh đại diện", 
                  "avatar", 
                  "", 
                  "avatar"
                  )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="description") Mô tả ngắn
                textarea.form-control(
                  id="description"
                  name="description"
                  rows="3"
                  textarea-mce
                  )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="content") Chi tiết bài viết
                textarea.form-control(
                  id="content"
                  name="content"
                  rows="3"
                  textarea-mce
                  )
          button.btn.btn-primary(type="submit") Tạo mới
          a.btn.btn-danger.ms-2(href=`/${pathAdmin}/products/product-list`) Hủy

    //- Modal File Manager
    
    //- End Modal File Manager