extends ../../layouts/default.pug
include ../../mixins/pagination.pug
include ../../mixins/form-search.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{title}
            // end col
            .col-auto
              a.btn.btn-primary(
                href=`/${pathAdmin}/products/product-attribute-create`
                )
                i.fa-solid.fa-plus.me-1
                | Tạo thuộc tính
                // end col
            // end col
          // end row
        // end card-header
        .card-body.pt-0
          .row
            .col-lg-6
              +form-search()
            .col-lg-2
              a.btn.w-100.btn-info(href=`/${pathAdmin}/products/product-attribute/export/csv`)
                i.fa-solid.fa-download.me-1
                | Xuất Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th STT
                  th Tên thuộc tính
                  th Kiểu hiển thị
                  th Danh sách lựa chọn
                  th.text-end Hành động
              tbody
                each attribute, index in recordList
                  tr
                    td #{pagination.skip + index + 1}
                    td #{attribute.name}
                    td #{attribute.type}
                    td
                      each item in attribute.options
                        span.badge.bg-primary.me-1 #{item.label}: #{item.value}
                    td.text-end
                      a(href=`/${pathAdmin}/products/product-attribute-edit/${attribute.id}`)
                        i.las.la-pen.text-secondary.fs-18
                      a(
                        href="javascript:;"
                        button-api
                        data-method="PATCH"
                        data-api=`/${pathAdmin}/products/product-attribute-delete/${attribute.id}`
                      )
                        i.las.la-trash-alt.text-secondary.fs-18
          +pagination()
      // end col
