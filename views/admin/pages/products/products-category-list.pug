extends ../../layouts/default.pug
include ../../mixins/pagination.pug
include ../../mixins/form-search.pug

block main 
  if (permissions.includes('product-category-list'))
    .container
      .row
        .col-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title #{title}
            .card-body.pt-0
              .row
                .col-lg-6
                  +form-search()
                .col-lg-2
                  a.btn.w-100.btn-info(href=`/${pathAdmin}/products/product-category/export/csv`)
                    i.fa-solid.fa-download.me-1
                    | Xuất Excel
              .table-responsive
                table.table.mb-0.checkbox-all(id="datatable_1")
                  thead.table-light
                    tr
                      th(style="width: 16px;")
                        .form-check.mb-0
                          input#select-all.form-check-input(
                            name="select-all" 
                            type="checkbox"
                            )
                      th.ps-0 STT
                      th Avatar
                      th Tên danh mục
                      th Danh mục cha
                      th Trạng thái
                      th Lượt xem
                      th.text-end Hành động
                  tbody
                    each category, index in (categories || [])
                      tr
                        td
                          .form-check.mb-0
                            input.form-check-input(
                              name="select-item" 
                              type="checkbox"
                              )
                        td #{pagination.skip + index + 1}
                        td
                          if category && category.avatar
                            img(
                              src=`${domainCDN}${category.avatar}` 
                              alt="Avatar"
                              width="50"
                              height="50"
                            )
                          else
                            img.avatar-sm.rounded-circle(src="/admin/assets/images/default-avatar.png" alt="Avatar")
                        td #{category && category.name ? category.name : 'Không có'}
                        td #{category && category.parentName ? category.parentName : 'Không có'}
                        td
                          if category && category.status === 'active'
                            span.badge.bg-success.text-white Hoạt động
                          else if category && category.status === 'inactive'
                            span.badge.bg-danger.text-white Dừng hoạt động
                          else
                            span.badge.bg-light.text-dark Không xác định
                        td #{category && typeof category.views !== 'undefined' ? category.views : 0}
                        td.text-end
                          if category && category._id
                            a.btn.btn-sm.btn-primary.me-1(href=`/admin/posts/category-edit/${category._id}`)
                              i.fa-solid.fa-pen-to-square
                            a.btn.btn-sm.btn-danger(
                              href=`javascript:;`
                              button-api
                              data-method="PATCH"
                              data-api=`/${pathAdmin}/products/product-category-delete/${category._id}`
                              )
                              i.fa-solid.fa-trash
              +pagination()