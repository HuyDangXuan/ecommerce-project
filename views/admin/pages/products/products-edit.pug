extend ../../layouts/default.pug
include ../../mixins/options.pug
include ../../mixins/form-group.pug
include ../../mixins/checkbox.pug

block main 
  if (permissions.includes('product-edit'))
    .container
      .row
        .col-12
          h1 Chỉnh sửa sản phẩm
      .card-body.pt-0
        form(id="editProductForm")
          input(type="hidden" name="id" value=product ? product._id : "")
          .row
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên sản phẩm *
                input.form-control(
                  id="name"
                  name="name"
                  type="text"
                  value=product ? product.name : ""
                  )
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="slug") Đường dẫn *
                .input-group
                  span.btn.btn-outline-info(
                    btn-generate-slug="Product"
                    from="name"
                    to="slug"
                  ) Tự động
                  input.form-control(
                    id="slug" 
                    name="slug" 
                    type="text" 
                    value=product ? product.slug : "")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-control(
                  id="status"
                  name="status"
                  )
                    option(value="draft" selected=product && product.status === "draft") Nháp
                    option(value="published" selected=product && product.status === "published") Công khai
                    option(value="archived" selected=product && product.status === "archived") Lưu trữ
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="category") Danh mục
                div(class="checkbox-list" checkbox-list="category")
                  +checkbox(categories, product ? product.category : [])
            .col-md-12.col-lg-12
              .mb-3
                +form-group-file(
                  "Ảnh đại diện", 
                  "avatar", 
                  "avatar",
                  product.avatar
                  )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="description") Mô tả ngắn
                textarea.form-control(
                  id="description"
                  name="description"
                  rows="3"
                  textarea-mce
                  ) #{product ? product.description : ""}
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="content") Chi tiết bài viết
                textarea.form-control(
                  id="content"
                  name="content"
                  rows="3"
                  textarea-mce
                  ) #{product ? product.content : ""}
          button.btn.btn-primary(type="submit") Câp nhật
          a.btn.btn-danger.ms-2(href=`/${pathAdmin}/products/product-list`) Hủy