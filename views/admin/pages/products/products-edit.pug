extend ../../layouts/default.pug
include ../../mixins/options.pug
include ../../mixins/form-group.pug
include ../../mixins/checkbox.pug

block main 
  if (permissions.includes('product-edit'))
    .container
      .row
        .col-12
          h1 Chỉnh sửa sản phẩm
      .card-body.pt-0
        form(id="editProductForm")
          input(type="hidden" name="id" value=product ? product._id : "")
          .row
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên sản phẩm *
                input.form-control(
                  id="name"
                  name="name"
                  type="text"
                  value=product ? product.name : ""
                  )
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="position") Vị trí
                input.form-control(
                  id="position"
                  name="position"
                  type="number"
                  value=product ? product.position : ""
                  )
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="slug") Đường dẫn *
                .input-group
                  span.btn.btn-outline-info(
                    btn-generate-slug="Product"
                    from="name"
                    to="slug"
                  ) Tự động
                  input.form-control(
                    id="slug" 
                    name="slug" 
                    type="text" 
                    value=product ? product.slug : "")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="stock") Còn lại
                input.form-control(
                  id="stock"
                  name="stock"
                  type="number"
                  value=product ? product.stock : "")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-control(
                  id="status"
                  name="status"
                  )
                    option(value="draft" selected=product && product.status === "draft") Nháp
                    option(value="published" selected=product && product.status === "published") Công khai
                    option(value="archived" selected=product && product.status === "archived") Lưu trữ
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="category") Danh mục
                div(class="checkbox-list" checkbox-list="category")
                  +checkbox(categories, 0, product.category)
            .col-md-6.col-lg-6
              .mb-3 
                label.form-label(for="priceOld") Giá cũ *
                input.form-control(
                  id="priceOld"
                  name="priceOld"
                  type="number"
                  value=product ? product.priceOld : ""
                  )
            .col-md-6.col-lg-6
              .mb-3 
                label.form-label(for="priceNew") Giá sản phẩm *
                input.form-control(
                  id="priceNew"
                  name="priceNew"
                  type="number"
                  value=product ? product.priceNew : ""
                  )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách thuộc tính
                div(class="checkbox-list" checkbox-list="attributes")
                  +checkbox(attributeList, 0, product.attributes)
                span.btn.btn-outline-info.mt-1(
                  button-render-variant="attributes"
                ) Tạo biến thể
                script.
                  const attributelist = !{JSON.stringify(attributeList)};
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách biến thể
                .table-responsive-sm
                  table.table.mb-0(variant-table)
                    thead.table-light
                      tr
                        th(scope="col") Trạng thái
                        each attributeName in attributeNameList
                          th(scope="col") #{attributeName}
                        th(scope="col") Giá cũ
                        th(scope="col") Giá mới
                        th(scope="col") Còn lại
                    tbody
                      each variant in product ? product.variants : []
                        tr
                          td
                            .form-check.form-switch.form-switch-success
                              input.form-check-input(
                                name="variant-status" 
                                type="checkbox"
                                checked=variant.status
                                )
                            input.d-none(attribute-value value=JSON.stringify(variant.attributeValue || []))
                          each attr in (variant.attributeValue || [])
                            td #{attr.label}
                          td
                            input.form-control(
                              type="number"
                              value=variant.priceOld
                              price-old
                            )
                          td
                            input.form-control(
                              type="number"
                              value=variant.priceNew
                              price-new
                            )
                          td
                            input.form-control(
                              type="number"
                              value=variant.stock
                              stock
                            )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách ảnh
                div(class="form-multi-file")
                  .input-group
                    span.btn.btn-outline-info(
                      data-bs-toggle="modal"
                      data-bs-target="#modalFileManager"
                    ) Chọn file
                    span.btn.btn-outline-info(
                      button-paste
                    ) Dán file
                  .inner-list-image(multi-file="images")
                    each image in product ? product.images : []
                      .inner-image
                        img(src=`${domainCDN}${image}` alt="" src-relative=image)
                        span.inner-remove x
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="description") Mô tả ngắn
                textarea.form-control(
                  id="description"
                  name="description"
                  rows="3"
                  textarea-mce
                  ) #{product ? product.description : ""}
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="content") Chi tiết bài viết
                textarea.form-control(
                  id="content"
                  name="content"
                  rows="3"
                  textarea-mce
                  ) #{product ? product.content : ""}
          button.btn.btn-primary(type="submit") Câp nhật
          a.btn.btn-danger.ms-2(href=`/${pathAdmin}/products/product-list`) Hủy