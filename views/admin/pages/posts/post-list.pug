extends ../../layouts/default.pug
include ../../mixins/pagination.pug

block main 
  if (permissions.includes('post-list'))
    .container
      .row
        .col-12
          .card
            .card-header
              .row.align-items-center
                .col
                  h4.card-title #{title}
            .card-body.pt-0
              .row
                .col-lg-6
                  +form-search()
                .col-lg-2
                  a.btn.w-100.btn-info(href=`/${pathAdmin}/posts/post/export/csv`)
                    i.fa-solid.fa-download.me-1
                    | Xuất Excel
              .table-responsive
                table.table.mb-0.checkbox-all(id="datatable_1")
                  thead.table-light
                    tr
                      th(style="width: 16px;")
                        .form-check.mb-0
                          input#select-all.form-check-input(
                            name="select-all" 
                            type="checkbox"
                            )
                      th.ps-0 STT
                      th Avatar
                      th Tên bài viết
                      th Danh mục
                      th Trạng thái
                      th Lượt xem
                      th.text-end Hành động
                  tbody
                    each post, index in (posts || [])
                      tr
                        td
                          .form-check.mb-0
                            input.form-check-input(
                              name="select-item" 
                              type="checkbox"
                              )
                        td #{pagination.skip + index + 1}
                        td
                          if post && post.avatar
                            img(
                              src=`${domainCDN}${post.avatar}` 
                              alt="Avatar"
                              width="50"
                              height="50"
                            )
                          else
                            img.avatar-sm.rounded-circle(src="/admin/assets/images/default-avatar.png" alt="Avatar")
                        td #{post && post.name ? post.name : 'Không có'}
                        td 
                          each category in post.categoryListName
                            span.badge.bg-info.text-white.me-1 #{category}
                        td
                          if post && post.status === 'draft'
                            span.badge.bg-success.text-white Nháp
                          else if post && post.status === 'published'
                            span.badge.bg-primary.text-white Công khai
                          else if post && post.status === 'archived'
                            span.badge.bg-danger.text-white Lưu trữ
                          else
                            span.badge.bg-light.text-dark Không xác định
                        td #{post && typeof post.views !== 'undefined' ? post.views : 0}
                        td.text-end
                          if post && post._id
                            a.btn.btn-sm.btn-primary.me-1(href=`/admin/posts/post-edit/${post._id}`)
                              i.fa-solid.fa-pen-to-square
                            a.btn.btn-sm.btn-danger(
                              href=`javascript:;`
                              button-api
                              data-method="PATCH"
                              data-api=`/${pathAdmin}/posts/post-delete/${post._id}`
                              )
                              i.fa-solid.fa-trash
              +pagination()