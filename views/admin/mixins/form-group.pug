mixin form-group-file(label = "", name = "", id = "", value = "", placeholder = "Đường dẫn ảnh...")
  div(form-group-file)
    label.form-label(for=id) #{label}
    .input-group
      span.btn.btn-outline-info(
          data-bs-toggle="modal"
          data-bs-target="#modalFileManager"
        ) Chọn file
      input.form-control(
        id=id
        name=name
        placeholder=placeholder
        value=value
        input-file
      )
      .preview-file(preview-file)