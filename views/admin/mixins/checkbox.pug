mixin checkbox(list = [], selectedIds = [], level = 0)
  each item in list
    - const marginLeft = `${level * 20}px`
    - const isChecked = Array.isArray(selectedIds) && selectedIds.map(String).includes(String(item.id))
    div(class="checkbox-item" style=`margin-left: ${marginLeft}`)
      input(type="checkbox" id=`checkbox-${item.id}` value=`${item.id}` checked=isChecked)
      label(for=`"checkbox-${item.id}"`) #{item.name}
    if (item.children && item.children.length > 0)
      +checkbox(item.children, selectedIds, level + 1)