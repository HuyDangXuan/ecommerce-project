mixin checkbox(list = [], level = 0, listChecked = [])
  each item in list
    - const marginLeft = `${level * 20}px`;
    div(class="checkbox-item" style=`margin-left: ${marginLeft}`)
      input(
        type="checkbox" 
        id=`checkbox-${item.id}` 
        value=item.id 
        checked=(listChecked.includes(item.id) ? true : false)
      )
      label(for=`checkbox-${item.id}`) #{item.name}
    if (item.children && item.children.length > 0)
      +checkbox(item.children, level + 1, listChecked)